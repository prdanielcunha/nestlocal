{
  "schemaVersion": 1,
  "appId": "nestlocal",
  "name": "NestLocal",
  "ai": {
    "enabled": true,
    "tasks": [
      "nestlocal.request.extract",
      "nestlocal.quote.compose",
      "nestlocal.followup.compose"
